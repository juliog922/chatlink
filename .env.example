# --- Logging ---
LOG_LEVEL=INFO

# --- Database Credentials ---
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=db

# --- Database Connection ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# SQLSERVER
SQLSERVER_USER=user
SQLSERVER_PASSWORD=pass
SQLSERVER_HOST=000.000.000.00
SQLSERVER_DB=db

# --- gRPC Server Config ---
WHATSMEOW_HOST=0.0.0.0
WHATSMEOW_PORT=50051

# --- Python Client Config ---
GRPC_HOST=meow_server
GRPC_PORT=50051
API_HOST=0.0.0.0
API_PORT=8000

# GMAIL
SMTP_SERVER=smtp.gmail.com
IMAP_SERVER=imap.gmail.com
SMTP_PORT=587
SMTP_PASSWORD=pass
SMTP_USER=example@example.es
GMAIL_ACCOUNTS_FILE=/app/gmail_accounts.json

# --- Kapa ---
RESPONSE_DELAY_MINUTES=15
# Dev only: route this user's mailbox through SMTP_USER.
# MOCK_EMAIL=example@gmail.com

# --- Inference (Tachyon) ---
# A Tachyon checkout, built into the tachyon image.
TACHYON_SRC=../tachyon
# gemma-4-e4b on the server; gemma-4-e2b on a small GPU.
KAPA_CHAT_MODEL=gemma-4-e4b
KAPA_LAYA_MODEL=laya-multilingual
# Only if the Hub rate-limits the first pull:
# HF_TOKEN=hf_...

# --- Monitoring ---
ALERT_EMAILS=admin@example.com
# HEARTBEAT_URL=https://hc-ping.com/<uuid>

# --- Admin API, bound to 127.0.0.1 only ---
KAPA_API_PORT=8000
